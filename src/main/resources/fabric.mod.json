{
	"schemaVersion": 1,
	"id": "simple-sort",
	"version": "${version}",
	"name": "Simple Sort",
	"description": "Quick and easy item distribution made simple. Use the distribution platform to sort items into chests, shulker boxes, and more with ease. No more manual sorting or complex GUIs!",
	"authors": [
		"FanaticalFoxx"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/simple-sort",
		"sources": "https://github.com/nullified-fox/simple-sort",
		"issues": "https://github.com/nullified-fox/simple-sort/issues"
	},
	"license": "ARR",
	"icon": "assets/simple-sort/icon.png",
	"environment": "*",
	"entrypoints": {
		"modmenu": [
			"me.simplesort.client.ModMenuIntegration"
		],
		"main": [
			"me.simplesort.Simplesort"
		],
		"client": [
			"me.simplesort.client.SimplesortClient"
		]
	},
	"mixins": [],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minimum_minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"cloth-config": ">=${cloth_config_version}"
	},
	"custom": {
		"modmenu": {
			"icon": "assets/simple-sort/icon.png",
			"update_checker": false
		}
	}
}
